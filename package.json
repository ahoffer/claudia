{
  "name": "@ahoffer/claudia",
  "productName": "Claudia",
  "version": "0.100.0",
  "description": "Multi-instance Claude Code orchestrator web UI",
  "author": "Aaron Hoffer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahoffer/claudia.git"
  },
  "homepage": "https://github.com/ahoffer/claudia",
  "bugs": {
    "url": "https://github.com/ahoffer/claudia/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "orchestrator",
    "ai",
    "terminal"
  ],
  "type": "module",
  "bin": {
    "claudia": "bin/claudia.mjs"
  },
  "files": [
    "bin/",
    "backend/dist/",
    "backend/hooks/",
    "backend/package.json",
    "frontend/dist/",
    "frontend/package.json",
    "shared/dist/",
    "shared/package.json",
    "start.sh",
    "start-dev.sh",
    "index.html",
    "styles.css",
    "version.txt",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),d=p.join('node_modules','node-pty','prebuilds');if(fs.existsSync(d)){fs.readdirSync(d).forEach(a=>{const h=p.join(d,a,'spawn-helper');if(fs.existsSync(h))fs.chmodSync(h,0o755)})}\"",
    "prepare": "npm run build -w shared && npm run build:backend",
    "start": "./start.sh",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test -w backend",
    "test:frontend": "npm test -w frontend",
    "test:watch": "concurrently \"npm run test:watch -w backend\" \"npm run test:watch -w frontend\"",
    "version:sync": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "release": "node scripts/release.mjs",
    "setup:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.57.0",
    "vitest": "^3.2.4"
  },
  "bundleDependencies": [
    "@claudia/shared"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@claudia/shared": "*",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@opencode-ai/sdk": "^1.1.14",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "get-port": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "opencode-studio-server": "^1.2.1",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  }
}
