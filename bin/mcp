#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# mcp — manage MCP servers on the Mac
#
# Usage: mcp <command> [args]
#   status    Show MCP server status and ports
#   restart   Restart MCP services
#   logs      Show recent logs (mcp logs [fs|shell])
#   stop      Stop MCP services
#
# Config is read at runtime from ~/.config/claudia/config so an IP change
# never requires re-running setup — just update MAC_IP in the config file.
# =============================================================================

CONFIG="${HOME}/.config/claudia/config"
[ -f "$CONFIG" ] && source "$CONFIG"

MCP_DIR="${HOME}/.local/share/claudia-mcp"
LOG_DIR="${MCP_DIR}/logs"
FS_LABEL="com.claudia.mcp.filesystem"
SHELL_LABEL="com.claudia.mcp.shell"
FS_PORT="${FS_MCP_PORT:-8100}"
SHELL_PORT="${SHELL_MCP_PORT:-8101}"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[✓]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
fail() { echo -e "${RED}[✗]${NC} $*"; }

usage() {
    echo "Usage: mcp <command> [args]"
    echo ""
    echo "Commands:"
    echo "  status          Show MCP server status and ports"
    echo "  restart         Restart MCP services"
    echo "  logs [fs|shell] Show recent logs (follow with fs or shell arg)"
    echo "  stop            Stop MCP services"
}

cmd="${1:-}"
shift || true

case "$cmd" in

    status)
        echo "=== MCP Server Status ==="
        echo ""
        for label in "$FS_LABEL" "$SHELL_LABEL"; do
            name="${label##*.}"
            if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
                pid=$(launchctl print "gui/$(id -u)/$label" 2>/dev/null \
                    | grep -m1 'pid' | awk '{print $NF}')
                ok "$name  (pid: ${pid:-unknown})"
            else
                fail "$name  (not loaded)"
            fi
        done
        echo ""
        echo "Ports:"
        for port in "$FS_PORT" "$SHELL_PORT"; do
            if lsof -i ":$port" -sTCP:LISTEN >/dev/null 2>&1; then
                ok "  :$port  listening"
            else
                fail "  :$port  not listening"
            fi
        done
        echo ""
        # Read IP at runtime — never baked in
        mac_ip="${MAC_IP:-$(cat "$MCP_DIR/host-ip.txt" 2>/dev/null || echo "unknown")}"
        echo "Mac IP advertised to clients: $mac_ip"
        echo "Logs: $LOG_DIR"
        ;;

    restart)
        echo "[→] Restarting MCP services..."
        launchctl kickstart -k "gui/$(id -u)/$FS_LABEL" 2>/dev/null \
            && ok "filesystem restarted" \
            || fail "filesystem restart failed"
        launchctl kickstart -k "gui/$(id -u)/$SHELL_LABEL" 2>/dev/null \
            && ok "shell restarted" \
            || fail "shell restart failed"
        sleep 2
        "$0" status
        ;;

    logs)
        target="${1:-}"
        if [ "$target" = "fs" ] || [ "$target" = "filesystem" ]; then
            tail -f "$LOG_DIR/filesystem-stderr.log"
        elif [ "$target" = "shell" ]; then
            tail -f "$LOG_DIR/shell-stderr.log"
        else
            echo "Recent filesystem log:"
            tail -5 "$LOG_DIR/filesystem-stderr.log" 2>/dev/null || echo "  (empty)"
            echo ""
            echo "Recent shell log:"
            tail -5 "$LOG_DIR/shell-stderr.log" 2>/dev/null || echo "  (empty)"
            echo ""
            echo "  mcp logs fs      follow filesystem log"
            echo "  mcp logs shell   follow shell log"
        fi
        ;;

    stop)
        echo "[→] Stopping MCP services..."
        launchctl bootout "gui/$(id -u)/$FS_LABEL" 2>/dev/null \
            && ok "filesystem stopped" \
            || warn "filesystem was not running"
        launchctl bootout "gui/$(id -u)/$SHELL_LABEL" 2>/dev/null \
            && ok "shell stopped" \
            || warn "shell was not running"
        ;;

    ""|--help|-h)
        usage
        ;;

    *)
        echo "Unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;

esac
