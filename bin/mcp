#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# mcp — manage claudia-client (which spawns MCP servers as children)
#
# Usage: mcp <command>
#   status   — check port 8100/8101 and claudia-client process
#   start    — launch claudia-client in the background
#   stop     — kill claudia-client
#   logs     — tail claudia-client log
# =============================================================================

CONFIG="${HOME}/.config/claudia/config"
[ -f "$CONFIG" ] && source "$CONFIG"

MCP_DIR="${HOME}/.local/share/claudia-mcp"
LOG_FILE="${MCP_DIR}/claudia-client.log"
PID_FILE="${MCP_DIR}/claudia-client.pid"
FS_PORT="${FS_MCP_PORT:-8100}"
SHELL_PORT="${SHELL_MCP_PORT:-8101}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLIENT_SCRIPT="${SCRIPT_DIR}/claudia-client.ts"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[✓]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
fail() { echo -e "${RED}[✗]${NC} $*"; }

mkdir -p "$MCP_DIR"

is_port_listening() {
    local port=$1
    # Use /dev/tcp if available (bash built-in), fall back to nc
    if (echo > /dev/null) 2>/dev/null; then
        (echo > /dev/tcp/127.0.0.1/"$port") 2>/dev/null && return 0 || return 1
    else
        nc -z 127.0.0.1 "$port" 2>/dev/null
    fi
}

client_pid() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "$pid"
            return 0
        fi
    fi
    return 1
}

usage() {
    echo "Usage: mcp <command>"
    echo ""
    echo "Commands:"
    echo "  status   check ports and claudia-client process"
    echo "  start    launch claudia-client in the background"
    echo "  stop     stop claudia-client"
    echo "  logs     tail claudia-client log"
}

cmd="${1:-}"
shift || true

case "$cmd" in

    status)
        echo "=== claudia-client status ==="
        echo ""
        if pid=$(client_pid); then
            ok "claudia-client  (pid: $pid)"
        else
            fail "claudia-client  (not running)"
        fi
        echo ""
        echo "MCP ports:"
        if is_port_listening "$FS_PORT"; then
            ok "  :${FS_PORT}  filesystem-mcp  listening"
        else
            fail "  :${FS_PORT}  filesystem-mcp  not listening"
        fi
        if is_port_listening "$SHELL_PORT"; then
            ok "  :${SHELL_PORT}  shell-mcp       listening"
        else
            fail "  :${SHELL_PORT}  shell-mcp       not listening"
        fi
        echo ""
        echo "Log: $LOG_FILE"
        ;;

    start)
        if pid=$(client_pid); then
            warn "claudia-client already running (pid: $pid)"
            exit 0
        fi
        echo "[→] Starting claudia-client..."
        nohup npx tsx "$CLIENT_SCRIPT" >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
        ok "claudia-client started (pid: $(cat "$PID_FILE"))"
        echo "    Log: $LOG_FILE"
        ;;

    stop)
        if pid=$(client_pid); then
            echo "[→] Stopping claudia-client (pid: $pid)..."
            kill "$pid" 2>/dev/null || true
            rm -f "$PID_FILE"
            ok "claudia-client stopped"
        else
            warn "claudia-client is not running"
        fi
        ;;

    logs)
        if [ ! -f "$LOG_FILE" ]; then
            echo "No log file yet: $LOG_FILE"
            exit 0
        fi
        tail -f "$LOG_FILE"
        ;;

    ""|--help|-h)
        usage
        ;;

    *)
        echo "Unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;

esac
